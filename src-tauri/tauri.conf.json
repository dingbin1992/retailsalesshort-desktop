{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "流向整理工具",
  "version": "3.6.0",
  "identifier": "com.retailsalesshort.desktop",
  "build": {
    "frontendDist": "../src/renderer",
    "devUrl": "http://localhost:1420"
  },
  "app": {
    "windows": [
      {
        "title": "流向整理工具",
        "width": 900,
        "height": 650,
        "minWidth": 700,
        "minHeight": 500,
        "resizable": true,
        "fullscreen": false,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "resources": {
      "../config/patterns.json": "config/patterns.json",
      "../dist/processing/cli.js": "dist/processing/cli.js",
      "../dist/processing/read-headers.js": "dist/processing/read-headers.js"
    },
    "targets": ["nsis", "dmg", "deb", "rpm", "appimage", "app"],
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "installerIcon": "icons/icon.ico",
        "languages": ["SimpChinese"]
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "libayatana-appindicator3-1",
          "librsvg2-2",
          "libssl3",
          "libsoup-3.0-0",
          "libjavascriptcoregtk-4.1-0"
        ]
      }
    }
  }
}
