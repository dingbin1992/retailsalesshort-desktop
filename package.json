{
  "name": "retailsalesshort-desktop",
  "version": "3.3.0",
  "description": "湖北区域每日网上下载出库汇总工具",
  "scripts": {
    "build:renderer": "esbuild src/renderer/main.tsx --bundle --platform=browser --target=es2020 --format=esm --jsx=automatic --jsx-import-source=preact --outfile=src/renderer/dist/main.js && esbuild src/renderer/config-editor.tsx --bundle --platform=browser --target=es2020 --format=esm --jsx=automatic --jsx-import-source=preact --outfile=src/renderer/dist/config-editor.js",
    "build": "esbuild src/processing/cli.ts --bundle --platform=node --target=node20 --outfile=dist/processing/cli.js && esbuild src/processing/read-headers.ts --bundle --platform=node --target=node20 --outfile=dist/processing/read-headers.js && node scripts/copy-tauri-api.js && npm run build:renderer",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:build:win": "tauri build --target x86_64-pc-windows-msvc",
    "tauri:build:mac": "tauri build --target aarch64-apple-darwin",
    "tauri:build:mac:x64": "tauri build --target x86_64-apple-darwin",
    "tauri:build:linux": "tauri build --target x86_64-unknown-linux-gnu",
    "download:node": "node scripts/download-node.js"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.2",
    "@types/node": "^25.8.0",
    "esbuild": "^0.28.0",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.0",
    "@types/iconv-lite": "^0.0.1",
    "exceljs": "^4.4.0",
    "iconv-lite": "^0.7.2",
    "preact": "^10.29.2",
    "xlsx": "^0.18.5"
  }
}
